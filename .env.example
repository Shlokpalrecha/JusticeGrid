# ── JusticeGrid environment configuration ───────────────────────────────
# Copy this file to .env and fill in real values for local development.
# In production, JWT_SECRET and JWT_REFRESH_SECRET MUST be >= 32 random
# characters — the app refuses to boot in production mode otherwise
# (see apps/api/src/config/env.ts).

NODE_ENV=development
PORT=4000

# Postgres connection string. The docker-compose service is named
# "postgres"; when running the API outside Docker against the compose
# database, use "localhost" instead.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://justicegrid:justicegrid@127.0.0.1:55432/justicegrid

# JWT signing secrets — generate with `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-dev-only-refresh

# Access token: short-lived, sent as Authorization: Bearer, held in memory
# on the client. Refresh token: longer-lived, opaque, stored hashed,
# rotated on every use, delivered as an httpOnly cookie.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# Global rate limit (all routes): RATE_LIMIT_MAX requests per
# RATE_LIMIT_WINDOW_MS per IP. /auth/login has its own stricter limit
# (5 attempts / 15 min / IP+email) enforced in code, not via env.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Civil-day/month clocks use India time. 24/48-hour clocks use elapsed hours.
TZ=Asia/Kolkata

# Optional fixed "today" for the seed script, so demo data (e.g. "hearing
# in 2 days") stays relative to a known date. ISO date, e.g. 2026-09-20.
# Leave unset to seed relative to the actual run date.
SEED_DATE=

# When true, the login screen shows a demo-credentials helper box.
DEMO_MODE=true

# ── Frontend (Vite) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_DEMO_MODE=true
