{
  "name": "justicegrid",
  "version": "0.1.0",
  "private": true,
  "description": "JusticeGrid \u2014 an academic prototype for explainable legal-aid workflow prioritization. Synthetic data only. Not a legal or judicial decision system.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "setup": "pnpm install && pnpm --filter @justicegrid/api run db:generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "pnpm --filter @justicegrid/api run db:reset",
    "db:seed": "pnpm --filter @justicegrid/api run db:seed",
    "db:studio": "pnpm --filter @justicegrid/api run db:studio",
    "db:migrate": "pnpm --filter @justicegrid/api run db:migrate",
    "diagrams": "node scripts/render-diagrams.mjs",
    "docs": "echo 'See docs/ for all written documentation.'",
    "ci": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky",
    "systems:stress": "node scripts/systems-stress.mjs"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "eslint": "9.15.0",
    "@eslint/js": "9.15.0",
    "typescript-eslint": "8.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "prettier": "3.3.3",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "@playwright/test": "1.49.0",
    "rimraf": "6.0.1",
    "@types/node": "20.17.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,json,md,mjs,cjs}": [
      "prettier --write"
    ]
  }
}
