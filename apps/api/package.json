{
  "name": "@justicegrid/api",
  "version": "0.1.0",
  "private": true,
  "description": "JusticeGrid API — Express + Prisma backend. Prototype, synthetic data only; not a legal or judicial decision system.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed/index.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@justicegrid/shared": "workspace:*",
    "@justicegrid/rules-engine": "workspace:*",
    "@prisma/client": "5.22.0",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-async-errors": "3.1.1",
    "zod": "3.23.8",
    "@node-rs/argon2": "2.0.2",
    "jsonwebtoken": "9.0.2",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "helmet": "8.0.0",
    "cors": "2.8.5",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "express-rate-limit": "7.4.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "node-cron": "3.0.3",
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "prisma": "5.22.0",
    "dotenv-cli": "7.4.2",
    "vitest": "2.1.5",
    "@vitest/coverage-v8": "2.1.5",
    "supertest": "7.0.0",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/cors": "2.8.17",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/supertest": "6.0.2",
    "@types/node-cron": "3.0.11",
    "@faker-js/faker": "9.2.0",
    "pino-pretty": "13.0.0"
  }
}
